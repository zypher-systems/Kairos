# Copy to .env and adjust.

# Host port for the Kairos UI/API
KAIROS_HTTP_PORT=8080

# Host port for a second server replica (compose profile `ha`).
# Put a reverse proxy in front of KAIROS_HTTP_PORT and this port for a
# single URL.
# KAIROS_HA_HTTP_PORT=8081

# Host port bound for Postgres (localhost dev only)
KAIROS_PG_PORT=5432

# Required. Encrypts job secrets and SSH credentials at rest.
# The server will not start if this is empty or "change-me-please".
#   openssl rand -hex 32
KAIROS_SECRET=

# Server log level: debug | info | warn | error
KAIROS_LOG_LEVEL=info

# Set true when serving behind TLS — marks session cookies Secure.
KAIROS_HTTPS=false

# Public URL when Kairos sits behind a reverse proxy / DNS name.
# The CSRF origin guard compares Origin to this host (proxies often
# rewrite Host to localhost). Also used for notification links and
# agent install URLs.
# KAIROS_PUBLIC_URL=https://kairos.example.com

# Server timezone default
TZ=UTC
