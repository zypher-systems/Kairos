FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags="-s -w -X github.com/zypher-systems/kairos/internal/version.Version=1.18.0" -o /out/kairos-agent ./cmd/kairos-agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata docker-cli docker-cli-buildx
COPY --from=build /out/kairos-agent /usr/local/bin/kairos-agent
ENTRYPOINT ["kairos-agent"]